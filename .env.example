# Alpaca Markets (Paper Trading recommended by default)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=True

# Google Gemini API (AI Analyst)
GEMINI_API_KEY=your_gemini_api_key

# Financial Modeling Prep (250 req/day free tier)
FMP_API_KEY=your_fmp_api_key

# Finnhub News API (60 req/min free tier)
FINNHUB_API_KEY=your_finnhub_api_key

# Gmail SMTP Alerts (Primary - 16-char Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=
EMAIL_RECIPIENT=your.email@gmail.com

# Optional Telegram Fail-Safe Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional custom path for private strategy parameters
STRATEGY_CONFIG_PATH=config/strategy.local.json
